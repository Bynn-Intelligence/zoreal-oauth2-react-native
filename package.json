{
  "name": "@zoreal/oauth2-react-native",
  "version": "0.2.0-0",
  "description": "Login with ZOREAL for React Native. A ZOREAL Verified Proof-of-Human behind every sign-in.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bynn-Intelligence/zoreal-oauth2-react-native.git"
  },
  "homepage": "https://zoreal.com",
  "keywords": [
    "zoreal",
    "oauth2",
    "oidc",
    "react-native",
    "login",
    "identity",
    "liveness"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.73",
    "react-native-svg": ">=13"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.0",
    "@types/react-test-renderer": "^18.3.1",
    "react": "18.2.0",
    "react-native": "^0.73.0",
    "react-native-svg": "^15.15.5",
    "react-test-renderer": "^18.2.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "fast-xml-parser": "^5.7.0"
  }
}
